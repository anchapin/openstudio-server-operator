{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "oscm-archive-64f0c8e2a1b3c4d5e6f7a8b9-dacdbd78",
    "namespace": "openstudio-server",
    "labels": {
      "app.kubernetes.io/managed-by": "openstudio-operator",
      "app.kubernetes.io/component": "archival",
      "energy.nrel.gov/archive-backend": "azure"
    },
    "annotations": {
      "energy.nrel.gov/analysis-id": "64f0c8e2a1b3c4d5e6f7a8b9",
      "energy.nrel.gov/archive-destination": "archive:os-archives/64f0c8e2a1b3c4d5e6f7a8b9"
    }
  },
  "spec": {
    "backoffLimit": 3,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "openstudio-operator",
          "app.kubernetes.io/component": "archival",
          "energy.nrel.gov/archive-backend": "azure"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "rclone",
            "image": "rclone/rclone:1.67.0",
            "command": [
              "/bin/sh",
              "-c",
              "set -eu\n\n# Generated by openstudio-server-operator (issue #15, D09) \u2014 do not edit.\n# Copies one analysis's NFS asset trees with rclone, then verifies each\n# with `rclone check` (size + hash). ANY mismatch exits nonzero: a\n# Completed Job is the verified-upload gate.\ndest=archive:os-archives/64f0c8e2a1b3c4d5e6f7a8b9\n\ncopy_check() {\n    src=\"$1\"\n    rel=\"$2\"\n    if [ ! -d \"$src\" ]; then\n        echo \"archival: ERROR: source directory missing on NFS: $src\" >&2\n        return 1\n    fi\n    echo \"archival: copy $src -> $dest/$rel\"\n    rclone copy \"$src\" \"$dest/$rel\"\n    echo \"archival: verify (size+hash) $src <=> $dest/$rel\"\n    rclone check \"$src\" \"$dest/$rel\"\n}\n\ncopy_check /mnt/openstudio/server/assets/analyses/64f0c8e2a1b3c4d5e6f7a8b9 analyses/64f0c8e2a1b3c4d5e6f7a8b9\ncopy_check /mnt/openstudio/server/assets/data_points/64f0c8e2a1b3c4d5e6f70001 data_points/64f0c8e2a1b3c4d5e6f70001\n\necho \"archival: all asset trees copied and verified (size+hash)\"\n"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "env": [
              {
                "name": "RCLONE_CONFIG_ARCHIVE_TYPE",
                "value": "azureblob"
              }
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "os-archive-creds"
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "nfs-assets",
                "mountPath": "/mnt/openstudio",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "nfs-assets",
            "persistentVolumeClaim": {
              "claimName": "nfs-pvc",
              "readOnly": true
            }
          }
        ]
      }
    }
  }
}
